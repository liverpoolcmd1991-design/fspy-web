{
  "name": "fspy-web",
  "private": true,
  "version": "1.1.0-beta.3",
  "type": "module",
  "homepage": "https://fspy.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/ntestu/fspy-web.git"
  },
  "author": {
    "name": "Per Gantelius",
    "email": "per@stuffmatic.com",
    "url": "https://stuffmatic.com"
  },
  "description": "Web app port of fSpy, an open source app for still image camera matching",
  "license": "GPL-3.0",
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/file-saver": "^2.0.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "gh-pages": "^6.1.1",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^6.3.5"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "deploy": "pnpm build && gh-pages --dist dist/",
    "dev": "vite --port 3000 --host 0.0.0.0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint:fix": "eslint --fix .",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "vite --port 3000 --host 0.0.0.0",
    "type-check": "tsc -b --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.174.0",
    "exifr": "^7.1.3",
    "file-saver": "^2.0.5",
    "lucide-react": "^1.70.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "three": "^0.174.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.0"
  }
}
